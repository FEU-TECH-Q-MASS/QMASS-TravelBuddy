# Server-only target used by the Next.js /api proxy. Rebuild after changing it.
BACKEND_URL=http://localhost:5000

# Safe to expose in the browser. These are required by the frontend clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Never put service-role keys or travel-provider credentials in NEXT_PUBLIC_*.
